# ────────────────────────────────────────────────
# Backend config — TEMPLATE. Copy to .env and fill in.
#
#   copy .env.example .env
#
# .env is the OFFLINE target: your machine's Postgres and your LAN IP.
# For the Render deployment use .env.production.example instead.
# Which file gets loaded is chosen by SERVER_MODE — see package.json:
#
#   npm run dev          -> mode=local   -> loads .env
#   npm run dev:online   -> mode=online  -> loads .env.production, then .env
#
# Real environment variables always win over both files, which is how Render
# injects its config.
# ────────────────────────────────────────────────

# local | online
SERVER_MODE=local

# Server
PORT=5000
HOST=0.0.0.0

# Postgres — local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres_ground_token

# Managed Postgres (Render, Neon, Supabase…) needs TLS. Leave false locally.
DB_SSL=false

# How hard to retry the first DB connection. Free-tier instances cold-start
# slowly, so 10 is the floor rather than the ceiling.
DB_CONNECT_ATTEMPTS=10

# Where uploaded activity images are written. Default ./uploads.
# UPLOAD_DIR=/var/data/uploads

# PayChangu payment gateway — TEST keys while you are still testing.
# These are NOT exposed to the app: only EXPO_PUBLIC_* vars reach the client.
PAYCHANGU_SECRET_KEY=SEC-TEST-your-key-here
PAYCHANGU_PUBLIC_KEY=PUB-TEST-your-key-here
PAYCHANGU_BASE_URL=https://api.paychangu.com
WEBHOOK_SECRET=wh_sec_test_your-webhook-secret
