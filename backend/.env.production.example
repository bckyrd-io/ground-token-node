# ────────────────────────────────────────────────
# Backend config for the Render deployment — TEMPLATE.
#
#   copy .env.production.example .env.production
#
# .env.production is git-ignored, so real credentials never land in the repo.
# You only need this file for `npm run dev:online` — pointing your laptop
# straight at Render. On Render itself these values come from the dashboard,
# which always override anything in a file.
#
# Fill the DB_* values from Render → your database → "Internal Database URL":
#
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Use the INTERNAL URL, not the external one — it resolves on Render's private
# network, never leaves it, and costs you no bandwidth.
#
# ────────────────────────────────────────────────

SERVER_MODE=online

NODE_ENV=production

# Render injects PORT for you. This only matters for local --mode=online runs.
PORT=5000
HOST=0.0.0.0

DB_HOST=dpg-xxxxxxxxxxxx-xxxx.oregon-postgres.render.com
DB_PORT=5432
DB_USER=your-render-db-user
DB_PASSWORD=your-render-db-password
DB_NAME=your-render-db-name

# Mandatory on Render — its Postgres refuses plaintext connections.
DB_SSL=true
DB_CONNECT_ATTEMPTS=10

# How long one play session lasts once a token is scanned, in milliseconds.
# 300000 = 5 minutes. Set to 60000 for a fast demo.
SESSION_DURATION_MS=300000

# PayChangu TEST keys. Swap for live keys only once the app is fully tested.
PAYCHANGU_SECRET_KEY=SEC-TEST-your-key-here
PAYCHANGU_BASE_URL=https://api.paychangu.com
WEBHOOK_SECRET=wh_sec_test_your-webhook-secret
