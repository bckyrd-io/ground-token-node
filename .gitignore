# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Environment variables
.env

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# env files that carry real credentials — never commit these.
# Only the *.example / *.template variants are tracked.
.env.production
.env.*.production

# web export (dist/ is already ignored above)
dist-web/

# logs
*.log

# typescript
*.tsbuildinfo

# backend build output (compiled from backend/server.ts by `npm run build`)
backend/server.js
backend/server.js.map
backend/server.d.ts
backend/server.d.ts.map

# backend dev scratch / diagnostic scripts (_dbcheck.mjs, _rendercheck.mjs, ...)
backend/_*.mjs

# uploaded activity images — runtime data, not source.
# ground1-4.jpg are seed fixtures referenced by the seed data, so they stay tracked.
backend/uploads/image-*
!backend/uploads/.gitkeep

app-example

# generated native folders
/ios
/android
